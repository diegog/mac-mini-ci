#!/bin/bash
# mac-build slot: keep one Tart VM slot busy with one-job (JIT) GitHub Actions runners.
#
#   mint JIT config -> clone base image -> boot VM (softnet) -> run.sh --jitconfig (one job) -> delete
#
# Runs forever as `ci` under launchd (one daemon per slot). Anything that fails backs off and
# retries; a VM is always deleted before the next cycle.
set -uo pipefail
SLOT=${1:?usage: mac-build-slot <slot-number>}
. /Users/ci/mac-mini-ci/mac-build.env
BIN=/Users/ci/mac-mini-ci/bin
export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
export TART_NO_AUTO_PRUNE=   # never evict the base image from the cache mid-cycle
VM=

log() { printf '%s slot%s %s\n' "$(date '+%F %T')" "$SLOT" "$*"; }
cleanup() {
  if [ -n "$VM" ]; then
    tart stop "$VM" >/dev/null 2>&1
    tart delete "$VM" >/dev/null 2>&1
    VM=
  fi
}
backoff() { log "$1; retrying in ${BACKOFF_SECONDS}s"; cleanup; sleep "$BACKOFF_SECONDS"; }
trap 'log "stopping"; cleanup; exit 0' INT TERM

# Orphans from a previous life of this slot.
for vm in $(tart list -q 2>/dev/null | grep "^job-$SLOT-"); do
  log "deleting orphan $vm"; tart delete "$vm" >/dev/null 2>&1
done

while :; do
  stamp=$(date +%s)
  VM="job-$SLOT-$stamp"
  name="mac-build-$(hostname -s)-$SLOT-$stamp"

  # 1. Credentials first, so a GitHub problem never leaves a VM behind.
  token=$("$BIN/github-app-token") || { backoff "could not mint an installation token"; continue; }
  body=$(jq -cn --arg n "$name" --arg l "$RUNNER_LABELS" \
    '{name: $n, runner_group_id: 1, labels: ($l | split(",")), work_folder: "_work"}')
  jit=$(curl -fsS -X POST \
    -H "Authorization: Bearer $token" -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    "https://api.github.com/repos/$GITHUB_REPO/actions/runners/generate-jitconfig" \
    -d "$body" | jq -er .encoded_jit_config) || { backoff "could not mint a JIT config"; continue; }
  unset token

  # 2. Fresh VM from the pinned image.
  tart clone "$TART_IMAGE" "$VM" || { backoff "clone failed"; continue; }
  tart set "$VM" --cpu "$VM_CPU" --memory "$VM_MEMORY_MB" || { backoff "tart set failed"; continue; }
  # shellcheck disable=SC2086  # EXTRA_TART_RUN_ARGS is intentionally word-split
  tart run --no-graphics --no-audio --net-softnet --dir="runner:$RUNNER_CACHE:ro" \
    $EXTRA_TART_RUN_ARGS "$VM" >/dev/null 2>&1 &
  tart_pid=$!
  tart ip "$VM" --wait 180 >/dev/null 2>&1 || { kill "$tart_pid" 2>/dev/null; backoff "VM got no IP"; continue; }
  ready=0
  for _ in $(seq 1 30); do tart exec "$VM" true >/dev/null 2>&1 && { ready=1; break; }; sleep 2; done
  [ "$ready" = 1 ] || { kill "$tart_pid" 2>/dev/null; backoff "guest agent never answered"; continue; }

  # 3. The image's bundled runner ages out (GitHub refuses runners more than ~30 days behind),
  # so install the pinned one from the shared cache first (fallback: a checksummed download).
  # Then one job: run.sh --jitconfig returns when it is done. The config is base64, safe to quote.
  tarball="actions-runner-osx-arm64-$RUNNER_VERSION.tar.gz"
  guest_script="set -e
rm -rf ~/actions-runner && mkdir -p ~/actions-runner && cd ~/actions-runner
if [ -f '/Volumes/My Shared Files/runner/$tarball' ]; then
  tar -xzf '/Volumes/My Shared Files/runner/$tarball'
else
  curl -fsSL -o /tmp/$tarball 'https://github.com/actions/runner/releases/download/v$RUNNER_VERSION/$tarball'
  echo '$RUNNER_SHA256  /tmp/$tarball' | shasum -a 256 -c - >/dev/null
  tar -xzf /tmp/$tarball
fi
./run.sh --jitconfig '$jit'"
  log "$VM up; installing runner $RUNNER_VERSION, then $name waits for a job"
  tart exec "$VM" /bin/zsh -lc "$guest_script"
  log "$VM finished (runner exit $?)"
  unset jit guest_script

  # 4. Throw it away.
  tart stop "$VM" >/dev/null 2>&1
  wait "$tart_pid" 2>/dev/null
  tart delete "$VM" >/dev/null 2>&1
  VM=
done

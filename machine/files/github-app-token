#!/bin/bash
# Print a one-hour GitHub App installation token. The only place the App key is read on the host.
set -euo pipefail
. /Users/ci/mac-mini-ci/runners.env
KEY=/Users/ci/.config/mac-mini-ci/github-app.pem

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$GITHUB_APP_ID" | b64url)
signature=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$KEY" -binary | b64url)

curl -fsS -X POST \
  -H "Authorization: Bearer $header.$payload.$signature" \
  -H 'Accept: application/vnd.github+json' \
  -H 'X-GitHub-Api-Version: 2022-11-28' \
  "https://api.github.com/app/installations/$GITHUB_APP_INSTALLATION_ID/access_tokens" \
  -d '{}' | jq -er .token

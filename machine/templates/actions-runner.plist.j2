<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- GitHub's bin/actions.runner.plist.template, as a LaunchDaemon: UserName + SessionCreate
       give the runner a user session without anyone logging in; KeepAlive because the runner's
       own supervisor exits 0 on several stop paths and the template has none. -->
  <key>Label</key><string>{{ label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ runner_root }}/runsvc.sh</string>
  </array>
  <key>UserName</key><string>{{ host.data.ci_user }}</string>
  <key>WorkingDirectory</key><string>{{ runner_root }}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/{{ host.data.ci_user }}/Library/Logs/{{ label }}/stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/{{ host.data.ci_user }}/Library/Logs/{{ label }}/stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ACTIONS_RUNNER_SVC</key><string>1</string>
    <key>HOME</key><string>/Users/{{ host.data.ci_user }}</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>SessionCreate</key><true/>
</dict>
</plist>

# Managed by pyinfra (machine/templates/mac-build.env.j2). Read by the mac-build slot loop and
# the GitHub App token helper. Not secret, but only `ci` needs it.
GITHUB_REPO={{ host.data.github_repo }}
GITHUB_APP_ID={{ host.data.github_app_id }}
GITHUB_APP_INSTALLATION_ID={{ host.data.github_app_installation_id }}
TART_IMAGE={{ host.data.tart_image }}
RUNNER_LABELS={{ host.data.build_runner_labels | join(',') }}
VM_CPU={{ host.data.build_vm_cpu }}
VM_MEMORY_MB={{ host.data.build_vm_memory_mb }}
EXTRA_TART_RUN_ARGS={{ host.data.build_extra_tart_run_args }}
RUNNER_VERSION={{ host.data.runner_version }}
RUNNER_SHA256={{ host.data.runner_sha256 }}
RUNNER_CACHE=/Users/{{ host.data.ci_user }}/mac-mini-ci/runner
BACKOFF_SECONDS=60
